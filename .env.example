# DeepSeek 官方 API Key：https://platform.deepseek.com 获取
# 一个 Key 全搞定：截图分析（多模态 deepseek-v4-flash-vision-exp）+ 日报/周报总结共用
DEEPSEEK_API_KEY=sk-你的DeepSeekKey

# 可选：单独指定截图分析的 Key（不填则自动复用 DEEPSEEK_API_KEY）
# 若想换用 NVIDIA NIM 视觉模型，可在此填 NVIDIA Key 并改 core/config.py 的 ANALYZE_BASE_URL/ANALYZE_MODEL
ANALYZE_API_KEY=
